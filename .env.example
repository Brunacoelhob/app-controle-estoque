# Copie para ".env" (que o Git ignora). Nunca commite valores reais.

# Chave que assina as sessões. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Senha do MySQL (usada pelo docker compose)
DB_PASSWORD=

# Fora do Docker (opcional): padrão é SQLite local em instance/estoque.db
# DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/estoque?charset=utf8mb4

# Em produção com HTTPS, coloque 1 para o cookie de sessão só trafegar por HTTPS
# SESSION_COOKIE_SECURE=1
